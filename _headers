/*
  # Cegah Clickjacking - website tidak bisa di-embed di iframe orang lain
  X-Frame-Options: DENY

  # Cegah MIME sniffing attack
  X-Content-Type-Options: nosniff

  # Paksa HTTPS selalu (1 tahun)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Batasi informasi yang dikirim ke website lain
  Referrer-Policy: strict-origin-when-cross-origin

  # Cegah XSS - izinkan resource hanya dari domain sendiri + Google Fonts
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; connect-src 'self'

  # Batasi akses fitur browser yang tidak perlu
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Cegah XSS di browser lama
  X-XSS-Protection: 1; mode=block
